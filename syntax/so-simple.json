{
  "name": "so-simple",
  "displayName": "So Simple",
  "type": "light",
  "colors": {
    "editor.background": "#fafafa",
    "editor.foreground": "#586e75"
  },
  "tokenColors": [
    {
      "scope": [
        "comment"
      ],
      "settings": {
        "foreground": "#839496"
      }
    },
    {
      "scope": [
        "keyword",
        "storage"
      ],
      "settings": {
        "foreground": "#6c71c4"
      }
    },
    {
      "scope": [
        "string"
      ],
      "settings": {
        "foreground": "#859900"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language"
      ],
      "settings": {
        "foreground": "#cb4b16"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#268bd2"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "support.type",
        "support.class"
      ],
      "settings": {
        "foreground": "#b58900"
      }
    },
    {
      "scope": [
        "punctuation"
      ],
      "settings": {
        "foreground": "#586e75"
      }
    },
    {
      "scope": [
        "meta.preprocessor"
      ],
      "settings": {
        "foreground": "#cb4b16"
      }
    },
    {
      "scope": [
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#2aa198"
      }
    }
  ]
}
